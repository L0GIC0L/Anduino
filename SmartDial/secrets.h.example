// Copy this file to secrets.h (same folder) and fill in your values.
// secrets.h is listed in .gitignore so your password and token stay off GitHub.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// Must be plain HTTP (no https), IP or hostname plus port.
#define HA_HOST   "http://192.168.1.50:8123"

// Home Assistant -> your profile -> Security -> Long-lived access tokens
#define HA_TOKEN  "paste-your-long-lived-token-here"
